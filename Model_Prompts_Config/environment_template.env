# -----------------------------------------------------------------------------
# AUTOSAR RAG Assistant — Environment Configuration Template
# Student: Pranav Jai S S (127003193) — SASTRA University
# Copy this file to .env and configure local passwords / credentials.
# -----------------------------------------------------------------------------

# PostgreSQL / PgVector storage configuration (Port 5532 for local Docker container)
DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# Qdrant Vector Database configuration
QDRANT_URL=http://localhost:6333
# Set to 123456 when using the provided Docker container configured with QDRANT__SERVICE__API_KEY
QDRANT_API_KEY=123456

# Project identifier for collection namespace isolation
AUTOSAR_PROJECT_ID=local

# Embedding configuration (384 for all-minilm, 768 for nomic-embed-text)
EMBEDDING_DIMENSIONS=384

# Optional: OpenRouter API key for cloud model inference (leave blank if running Ollama locally)
OPENROUTER_API_KEY=
